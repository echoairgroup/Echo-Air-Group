# Copy this file to .env locally. Never commit .env or real credentials.
PORT=3000
NODE_ENV=development

# Use a development-only Neon branch/database. Never point local development at production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/echoair_staging?sslmode=require

# Required for account registration/login and signed sessions. Generate a unique secret.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Comma-separated integer IDs from the public.users table. Leave empty to disable admin-only routes.
ADMIN_USER_IDS=

# Optional browser origin allow-list. Set exact origins after verifying the canonical website host.
# Example: CORS_ORIGINS=https://echoairgroup.github.io
CORS_ORIGINS=

# Optional integrations. Never put these values in frontend HTML or commit them.
NEWSKY_API_KEY=
NEWSKY_AIRLINE_ID=
NEWSKY_HISTORY_START=2020-01-01

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Optional: send privacy-safe submission reference notifications to this text channel.
DISCORD_APPLICATIONS_CHANNEL_ID=
DISCORD_REDIRECT_URI=
DISCORD_ROLE_CADET=
DISCORD_ROLE_FIRST_OFFICER=
DISCORD_ROLE_SENIOR_FIRST_OFFICER=
DISCORD_ROLE_CAPTAIN=
DISCORD_ROLE_SENIOR_CAPTAIN=
DISCORD_ROLE_COMMANDER=
